<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/iModel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/iSys" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF" android:textSize="11sp" android:paddingTop="2dp" />
    <TextView android:id="@+id/iMem" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF" android:textSize="11sp" android:paddingTop="2dp" />
    <TextView android:id="@+id/iTemp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFBFA8FF" android:textStyle="bold" android:textSize="12sp" android:paddingTop="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Son oynananlar" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"
        android:paddingTop="10dp" android:paddingBottom="2dp" />
    <TextView android:id="@+id/iEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Henüz oynanmadı" android:textColor="#B3FFFFFF" android:textSize="11sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/i1r" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/i1n" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/i1t" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFBFA8FF" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/i2r" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/i2n" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/i2t" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFBFA8FF" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/i3r" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/i3n" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/i3t" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFBFA8FF" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
