<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg_white" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/iModel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/iSys" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:paddingTop="1dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="10dp">
            <TextView android:id="@+id/iRamL" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="RAM" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/iRamV" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/iRamBar" android:layout_width="match_parent" android:layout_height="7dp"
            android:layout_marginTop="4dp" android:scaleType="fitXY" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="9dp">
            <TextView android:id="@+id/iStoL" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Depolama" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/iStoV" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/iStoBar" android:layout_width="match_parent" android:layout_height="7dp"
            android:layout_marginTop="4dp" android:scaleType="fitXY" />

        <TextView android:id="@+id/iTemp" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textStyle="bold" android:textSize="12sp" android:paddingTop="10dp" />
    </LinearLayout>
</FrameLayout>
