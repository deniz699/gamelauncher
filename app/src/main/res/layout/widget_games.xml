<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Kartın yüksekliği oyun sayısına göre kodla ayarlanır; fazlası kaydırılır -->
    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="top">
        <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/widget_bg_white" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="14sp" android:paddingBottom="6dp"
                android:paddingLeft="2dp" android:paddingRight="2dp" android:maxLines="1" android:ellipsize="end" />
            <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp"
                android:scrollbars="none" android:overScrollMode="never" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Henüz oyun yok" android:textSize="12sp" android:paddingLeft="2dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
